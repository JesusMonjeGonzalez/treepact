{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treepact.local/schemas/runtime.schema.json",
  "title": "TreePact runtime adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "adapter_version",
    "supported_runtime_versions",
    "capabilities",
    "available_tools",
    "required_configuration",
    "cancellation_semantics",
    "event_coverage",
    "known_limitations",
    "assurance_ceiling"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "supported_runtime_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "session_start",
          "session_cancel",
          "session_resume",
          "structured_tools",
          "permission_events",
          "lifecycle_events",
          "usage_metadata",
          "controlled_tool_inventory",
          "subagent_events",
          "worktree_events"
        ]
      }
    },
    "available_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "required_configuration": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "cancellation_semantics": {
      "enum": ["cooperative", "process_group", "remote_abort", "mixed"]
    },
    "event_coverage": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "assurance_ceiling": {
      "enum": ["TP0", "TP1", "TP2", "TP3"]
    }
  }
}
