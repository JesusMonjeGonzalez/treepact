{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treepact.local/schemas/event.schema.json",
  "title": "TreePact event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "event_type",
    "schema_version",
    "occurred_at",
    "actor",
    "correlation_id",
    "pact_sha256",
    "payload",
    "event_sha256"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "schema_version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causation_id": { "type": ["string", "null"], "maxLength": 128 },
    "pact_sha256": { "$ref": "#/$defs/sha256" },
    "payload": {
      "type": "object",
      "description": "Validated by the event-type-specific payload schema registered for event_type and schema_version. This envelope alone is not sufficient payload validation."
    },
    "previous_event_sha256": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "event_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
